{
    "autoMemoryEnabled": false,
    "permissions": {
        "allow": [
            "Bash(git *)"
        ]
    },
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_orientation.py\"",
                        "timeout": 15,
                        "statusMessage": "Reading open OpenSpec changes"
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_openspec_branch.py\"",
                        "timeout": 10,
                        "statusMessage": "Checking OpenSpec branch policy"
                    }
                ]
            },
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_git_history.py\"",
                        "timeout": 10,
                        "statusMessage": "Checking git history policy"
                    }
                ]
            }
        ]
    }
}
