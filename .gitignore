delete-me-*

# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# publish/ is deliberately NOT ignored. Rendered artefacts are versioned by ruleset
# version and language so the tree can be pushed to a single source of truth; committing
# them is what makes "which PDF did we publish for 0.2.0 Draft" answerable later.

# Virtual environments
.venv/
venv/
env/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Linting / type-checking caches
.ruff_cache/
.mypy_cache/

# Environment variables
.env
.env.*

# Editor/OS
.DS_Store
*.swp
